{
    "rewrites": [
        {
            "source": "/:kind(f|p)/:token",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(bot|crawler|spider|facebookexternalhit|whatsapp|slack|twitter|linkedin|discord|telegram|skype|pinterest|embedly|preview).*"
                }
            ],
            "destination": "https://pollrange.onrender.com/api/share/:kind/:token"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/.well-known/ai-catalog.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json; charset=utf-8"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/llms.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/markdown; charset=utf-8"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ]
}
