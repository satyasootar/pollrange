{
  "name": "kollects-trailer",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Trailer out/kollects-trailer.mp4 --crf=18",
    "typecheck": "tsc --noEmit",
    "voice": "python scripts/voice.py",
    "wt:sandbox": "node scripts/sandbox.mjs",
    "wt:seed": "node scripts/seed.mjs",
    "wt:voice": "python scripts/voice.py --walkthrough",
    "wt:record": "node scripts/record.mjs",
    "wt:render": "remotion render src/index.ts Walkthrough out/kollects-walkthrough.mp4 --crf=18 --offthreadvideo-cache-size-in-bytes=3000000000 --concurrency=4",
    "wt:progress": "node scripts/progress.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@remotion/cli": "^4.0.537",
    "@remotion/sfx": "^4.0.537",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "playwright": "^1.64.1",
    "typescript": "5.9"
  }
}
