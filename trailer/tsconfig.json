{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "ES2023"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ]
}
